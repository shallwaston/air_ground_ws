# Example only. Copy this file to env/machine_a_default.env and edit every value for the real machine.

STAGE2_MACHINE_ROLE="machine_a"  # Example value. Replace if your team uses a different role name.
STAGE2_MODE="default_discovery"  # Example value. Replace if needed.
WORKSPACE_PATH="/home/ubuntu/air_ground_ws"  # Example path. Replace with the real workspace path on machine A.

ROS_DOMAIN_ID="0"  # Example value. Replace with the real shared domain ID.
RMW_IMPLEMENTATION="rmw_fastrtps_cpp"  # Example value. Replace only if your real test uses another RMW.
ROS_LOCALHOST_ONLY="0"  # Example value. For real dual-machine tests this must not be 1.

# Default-discovery smoke intentionally does not use ROS_DISCOVERY_SERVER.
# If your shell already exports ROS_DISCOVERY_SERVER, the default-smoke scripts will unset it.
