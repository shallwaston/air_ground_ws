# Example only. Copy this file to env/machine_a_discovery.env or env/machine_b_discovery.env and edit every value for the real machine.

STAGE2_MACHINE_ROLE="discovery_server"  # Example value. Change to machine_a or machine_b after copying for the real machine.
STAGE2_MODE="discovery_server"  # Example value. Replace if your team uses another label.
WORKSPACE_PATH="/home/ubuntu/air_ground_ws"  # Example path. Replace with the real workspace path on the target machine.

ROS_DOMAIN_ID="0"  # Example value. Replace with the real shared domain ID.
RMW_IMPLEMENTATION="rmw_fastrtps_cpp"  # Example value. Discovery Server mode expects Fast DDS in this workspace.
ROS_LOCALHOST_ONLY="0"  # Example value. For real dual-machine tests this must not be 1.

DISCOVERY_SERVER_IP="192.168.50.10"  # Example only. Replace with machine A's real reachable IP.
DISCOVERY_SERVER_PORT="11811"  # Example only. Replace only if your real test uses a different port.
ROS_DISCOVERY_SERVER="192.168.50.10:11811"  # Example only. Replace with the real host:port pair.
