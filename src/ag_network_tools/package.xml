<?xml version="1.0"?>
<!-- Shared QoS and topic utilities used across the workspace. -->
<package format="3">
  <name>ag_network_tools</name>
  <version>0.1.0</version>
  <description>Shared ROS 2 topic and QoS helpers for the air-ground MVP.</description>
  <maintainer email="dev@example.com">Codex</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
