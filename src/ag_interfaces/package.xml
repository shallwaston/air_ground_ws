<?xml version="1.0"?>
<!-- Message definitions for the air-ground communication MVP workspace. -->
<package format="3">
  <name>ag_interfaces</name>
  <version>0.1.0</version>
  <description>Custom ROS 2 interfaces for the air-ground communication MVP.</description>
  <maintainer email="dev@example.com">Codex</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export/>
</package>
